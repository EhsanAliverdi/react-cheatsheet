{
  "version": "2.0.0",
  "tasks": [
    // ── Dev Server ────────────────────────────────────────────
    {
      "label": "Dev: Start",
      "type": "shell",
      "command": "npm run dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): error: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local:\\s+http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },

    // ── Build ─────────────────────────────────────────────────
    {
      "label": "Build: Production",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    },

    // ── Preview ───────────────────────────────────────────────
    {
      "label": "Preview: Production Build",
      "type": "shell",
      "command": "npm run preview",
      "isBackground": true,
      "dependsOn": "Build: Production",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },

    // ── Type Check ────────────────────────────────────────────
    {
      "label": "TypeScript: Check",
      "type": "shell",
      "command": "npx tsc -b --noEmit",
      "group": "test",
      "problemMatcher": ["$tsc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    },

    // ── Lint ──────────────────────────────────────────────────
    {
      "label": "Lint: ESLint",
      "type": "shell",
      "command": "npm run lint",
      "group": "test",
      "problemMatcher": ["$eslint-stylish"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    },

    // ── Install ───────────────────────────────────────────────
    {
      "label": "Install: npm install",
      "type": "shell",
      "command": "npm install",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "build"
      }
    },

    // ── Docker ────────────────────────────────────────────────
    {
      "label": "Docker: Build Image",
      "type": "shell",
      "command": "docker build -t react-cheatsheet:local .",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "docker"
      }
    },

    {
      "label": "Docker: Run Container",
      "type": "shell",
      "command": "docker run --rm -p 8080:80 react-cheatsheet:local",
      "isBackground": true,
      "dependsOn": "Docker: Build Image",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "docker"
      }
    }
  ]
}
